{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "tex/**"],
    "headers": [
      {
        "source": "**/*.@(glb|json)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
      },
      {
        "source": "assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
